---
import { Image } from "astro:assets";
import type { ImageFunction } from "astro:content";

interface Props {
    name: ImageMetadata;
    altTxt: string;
}
const { name, altTxt } = Astro.props;
---

<style>
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(3, 2fr);
    }

    .pf-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

<Image src={name} class="pf-img" alt={altTxt} />
