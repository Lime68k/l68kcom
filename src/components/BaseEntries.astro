---
interface Props {
    entry: string;
    url: string;
}
const { entry, url } = Astro.props;
---

<div class="entries-list">
    <li>
        <a href={url} class="external-link">{entry}</a>
    </li>
</div>

<style>
    .entries-list li {
        list-style-type: none;
        font-size: 100%;
        line-height: 2.2;
        padding-top: 8px;
    }

    .entries-list {
        padding-top: 10px;
    }
</style>
