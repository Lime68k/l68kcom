---
import BaseLayout from "../layouts/BaseLayout.astro";
import resilience from "../assets/img/resilience.jpg";
import trnscrptn from "../assets/img/trnscrptn.jpg";
import cluttered from "../assets/img/cluttered.jpg";
import bellyof from "../assets/img/bellyof.jpg";
import toplaprennes from "../assets/img/toplaprennes.png";
import aa from "../assets/img/19.jpg";
import { Image } from "astro:assets";
---

<BaseLayout
    title="portfolio"
    desc="artworks and graphic related stuff i've worked on"
    pageId="portfolio"
>
    <h1 id="portfoliotitle">portfolio</h1>
    <h4>artworks and graphic related stuff i've worked on</h4>
    <style>
        #pf-cont {
            flex-direction: column;
            width: 80%;
            height: 80%;
        }
        .pf-img {
            width: 80%;
            height: 80%;
        }
        .pf-el {
            padding-bottom: 10%;
        }
    </style>

    <div id="pf-cont">
        <div class="pf-el">
            <a
                href="https://evel.bandcamp.com/album/resilience"
                class="external-link"
                target="_blank">resilience by daniel m karlsson</a
            >
            <Image
                src={resilience}
                class="pf-img"
                alt="Resilience by Daniel M Karlsson"
            />
        </div>
        <div class="pf-el">
            <a
                href="https://clutteredmembrane.bandcamp.com/album/trnscrptn"
                class="external-link"
                target="_blank">trnscrptn by azkyll</a
            >
            <Image src={trnscrptn} class="pf-img" alt="TRNSCRPTN by Azkyll" />
        </div>
        <div class="pf-el">
            <a
                href="https://clutteredmembrane.bandcamp.com/"
                class="external-link"
                target="_blank">logo for cluttered membrane</a
            >
            <Image src={cluttered} class="pf-img" alt="Clutterd Membrane" />
        </div>
        <div class="pf-el">
            <a
                href="https://azkyll.bandcamp.com/album/bellyofthebeast"
                class="external-link"
                target="_blank">bellyofthebeast by azkyll</a
            >
            <Image
                src={bellyof}
                class="pf-img"
                alt="bellyofthebeast by Azkyll"
            />
        </div>
        <div class="pf-el">
            <a
                href="https://instagram.com/toplap_rennes"
                class="external-link"
                target="_blank">logo for toplap rennes</a
            >
            <Image src={toplaprennes} class="pf-img" alt="TOPLAP Rennes" />
        </div>
        <div class="pf-el">
            other stuff in the <a href="/gallery" class="internal-link"
                >gallery</a
            >
            <Image src={aa} class="pf-img" alt="to gallery" />
        </div>
    </div>
</BaseLayout>
