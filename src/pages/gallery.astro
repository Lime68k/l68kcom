---

<style>
    @media (max-width: 900px) {
        .gallery {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
        }
    }

    @media screen {
        .gallery {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<BaseLayout title="gallery" desc="visual stuff" pageId="gallery">
    <h1 id="gallerytitle">gallery</h1>
    <h4>visual stuff</h4>
    <div class="gallery">
        <BaseGallery name={az} altTxt="" />
        <BaseGallery name={ay} altTxt="" />
        <BaseGallery name={ax} altTxt="" />
        <BaseGallery name={aw} altTxt="" />
