<BaseLayout title="vjing resources" desc="resources" pageId="vjing">
    <h1 id="thingstitle">vjing tools and resources list</h1>
    <h4>
        <span style="color: rgb(164 255 54)">← </span><a
            href="/l68kcom/things"
            class="internal-link">go back to things</a
        >
    </h4>
    <h4>
        a curated list of vjing and visuals related tools, originally published
        on
        <a
            href="https://github.com/LimeLimeW/awesome-vjing"
            target="_blank"
            class="external-link">github</a
        >.
    </h4>

    <div class="things card">
        <div class="category-read">resources</div>
        <p>various resources on learning to create and generate visuals</p>
        <div class="stuff-rows card_down">
            <details>
                <summary class="unfold clic">📂˚°•</summary>

                <h4>readings</h4>
                <ul>
                    <li>
                        <a
                            href="https://thebookofshaders.com/"
                            class="external-link">The Book of Shaders</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://helpx.adobe.com/after-effects/tutorials.html"
                            class="external-link"
                            >After Effects tutorials by Adobe</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://docs.cycling74.com/max8/tutorials/jitindex"
                            class="external-link"
                            >Max (Jitter/Vizzie) Documentation and tutorials by
                            Cycling &#39;74</a
                        >
                    </li>
                    <li>
                        <a href="https://iquilezles.org/" class="external-link"
                            >Inigo Quilez&#39;s website</a
                        >
                    </li>
                    <li>
                        <a href="./respectyourvj.html" class="internal-link"
                            >Respect Your VJ</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://davidlubl.in/blog/2014/vjing-wtf-is-it"
                            class="external-link"
                            >Vjing WTF is it by David Lublin</a
                        >
                    </li>
                </ul>

                <h4>videos</h4>
                <ul>
                    <li>
                        <a
                            href="https://www.youtube.com/watch?v=5RYy8Cvgkqk&list=PLD45EDA6F67827497"
                            class="external-link"
                            >Delicious Max Tutorials by dude837</a
                        >
                        (Contains Jitter tutorials)
                    </li>
                    <li>
                        <a
                            href="https://www.youtube.com/c/AmazingMaxStuff"
                            class="external-link">Amazing Max Stuff</a
